# Replit: TrojanHub website + AI service in one app, one public URL (see DEPLOY.md).
# Secrets (SUPABASE_*, NEXT_PUBLIC_*, LLM_*, CRON_SECRET...) go in the Secrets tab, never here.
modules = ["python-3.11", "nodejs-22"]
run = "sh scripts/replit-start.sh"

[deployment]
deploymentTarget = "gce"
build = ["sh", "-c", "pip install torch torchvision --index-url https://download.pytorch.org/whl/cpu && grep -v '^pytest' services/ai/requirements.txt > /tmp/req.txt && pip install -r /tmp/req.txt && npm ci && npm install --no-save --prefix .codex-cli @openai/codex@0.154.0 && API_PROXY_TARGET=http://127.0.0.1:8000 NEXT_PUBLIC_API_URL=/ NEXT_PUBLIC_SUPABASE_URL=${NEXT_PUBLIC_SUPABASE_URL:-$SUPABASE_URL} NEXT_PUBLIC_SUPABASE_ANON_KEY=${NEXT_PUBLIC_SUPABASE_ANON_KEY:-$SUPABASE_ANON_KEY} npm --workspace apps/web run build"]
run = ["sh", "scripts/replit-start.sh"]

[[ports]]
localPort = 3000
externalPort = 80

# Replit's own package installer must stay off: the build above installs everything. When it ran
# during a publish it rewrote files in .pythonlibs while the deploy image was being packed, and the
# publish failed with "archive/tar: write too long" (2026-11-14).
[packager]
language = "python3"

[packager.features]
enabledForHosting = false
guessImports = false
packageSearch = false
