{
  "name": "trojanhub",
  "private": true,
  "version": "0.1.0",
  "description": "TrojanHub monorepo: Expo app, Next.js web, shared TS package",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "mobile": "npm --workspace apps/mobile run start",
    "web": "npm --workspace apps/web run dev",
    "ai": "cd services/ai && uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "typescript": "^5"
  }
}
