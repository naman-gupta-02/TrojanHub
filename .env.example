# Copy to .env (never commit .env). See ARCHITECTURE.md §8 and §13.2.

# --- Supabase ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
# AI service only. Never put this in the mobile or web app.
SUPABASE_SERVICE_ROLE_KEY=

# --- LLM (any OpenAI-compatible endpoint: Codex shim, Ollama or backup API key; see services/ai/README.md) ---
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Optional: separate endpoint for vision / tool calls if the main one can't do them
LLM_VISION_BASE_URL=
LLM_VISION_API_KEY=
LLM_VISION_MODEL=

# --- AI service ---
# true = endpoints serve the JSON mocks in packages/shared/mocks/
USE_MOCKS=true
# Features that are real even while USE_MOCKS=true (comma-separated):
# chat, lostfound, events, notify, complaints, admin. Real features need a signed-in student.
REAL_FEATURES=
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# --- Notifications ---
RESEND_API_KEY=
CRON_SECRET=
# P3 (optional): links inside emails / .ics files, and the digest sender
PUBLIC_API_URL=http://localhost:8000
PUBLIC_WEB_URL=http://localhost:3000
DIGEST_FROM=TrojanHub <onboarding@resend.dev>
# P3 (optional): true = events/deals serve mocks even when Supabase is set
P3_USE_MOCKS=false
# P3 (optional): true = this instance runs the digest (8 AM LA) and reminder (10 min) jobs itself.
# Turn on for ONE instance only (the demo laptop), never on Replit as well.
CRON_INLINE=false

# --- Clients (point at the AI service, e.g. http://<laptop-ip>:8000) ---
EXPO_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
