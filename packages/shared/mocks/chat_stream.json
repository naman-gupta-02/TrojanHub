        {"type": "confirm", "action_id": "act_mock_complaint", "tool": "log_complaint", "title": "Log a complaint", "summary": "Facilities · HVAC · medium · GFS 213 · 4 others reported this", "draft": {
          "text": "it's so hot in GFS 213", "department": "Facilities", "category": "HVAC", "urgency": "medium", "building": "GFS", "room": "213", "summary": "Room is too hot; AC may not be working", "anonymous": false
        }},
        {"type": "done", "session_id": "mock-session"}
      ]
