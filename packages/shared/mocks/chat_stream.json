{
  "_about": "Mock SSE stream for POST /api/chat (P1). Each event is sent as `data: <json>\\n\\n`. The server picks a scenario whose `match` words appear in the message, otherwise `no_answer`. A message with a photo always gets the `flyer` scenario. All hours and contacts here are placeholders marked [MOCK]; the real bot copies them from scraped pages.",
  "_event_shapes": {
    "token": {"type": "token", "text": "string chunk of the answer"},
    "tool_call": {"type": "tool_call", "id": "call_1", "name": "tool name", "arguments": {}},
    "tool_result": {"type": "tool_result", "id": "call_1", "name": "tool name", "result": {}},
    "sources": {"type": "sources", "sources": [{"n": 1, "title": "", "url": "", "snippet": ""}]},
    "confirm": {"type": "confirm", "action_id": "act_1", "tool": "tool name", "title": "card title", "summary": "one line", "draft": {}},
    "done": {"type": "done", "session_id": "string"}
  },
  "scenarios": {
    "pantry": {
      "match": ["pantry", "food bank", "basic needs"],
      "events": [
        {"type": "tool_call", "id": "call_1", "name": "search_usc_info", "arguments": {"query": "Trojan Food Pantry hours and location"}},
        {"type": "tool_result", "id": "call_1", "name": "search_usc_info", "result": {"chunks": 2, "top_score": 0.71}},
        {"type": "token", "text": "The Trojan Food Pantry is run by USC Student Basic Needs. "},
        {"type": "token", "text": "It's open [MOCK: hours from the page] at [MOCK: location] [1]. "},
        {"type": "token", "text": "You can reach Basic Needs at [MOCK: email from page] [2]."},
        {"type": "sources", "sources": [
          {"n": 1, "title": "Trojan Food Pantry | Student Basic Needs", "url": "https://studentbasicneeds.usc.edu/programs-and-services/food-support/trojan-food-pantry/", "snippet": "[MOCK] The Trojan Food Pantry provides..."},
          {"n": 2, "title": "Contact | Student Basic Needs", "url": "https://studentbasicneeds.usc.edu/contact/", "snippet": "[MOCK] Contact us..."}
        ]},
        {"type": "done", "session_id": "mock-session"}
      ]
    },
